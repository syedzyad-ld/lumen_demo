{
  "datasets": [
    {
      "name": "ds_kpi_totals",
      "displayName": "KPI Totals",
      "query": "SELECT ROUND(SUM(total_revenue), 2) as total_revenue, ROUND(SUM(total_profit), 2) as total_profit, SUM(total_orders) as total_orders, ROUND(AVG(avg_profit_margin) * 100, 1) as avg_profit_margin_pct FROM dev_gold.reporting.agg_monthly_sales"
    },
    {
      "name": "ds_monthly_revenue",
      "displayName": "Monthly Revenue Trend",
      "query": "SELECT CAST(year AS STRING) as year, month, month_name, ROUND(total_revenue, 2) as total_revenue, ROUND(total_profit, 2) as total_profit FROM dev_gold.reporting.agg_monthly_sales ORDER BY year, month"
    },
    {
      "name": "ds_regional_summary",
      "displayName": "Regional Summary",
      "query": "SELECT region, manager_name, ROUND(total_revenue, 2) as total_revenue, ROUND(total_profit, 2) as total_profit, total_orders, total_customers, ROUND(avg_profit_margin * 100, 1) as avg_profit_margin_pct, ROUND(revenue_per_customer, 2) as revenue_per_customer FROM dev_gold.reporting.agg_regional_summary ORDER BY total_revenue DESC"
    },
    {
      "name": "ds_customer_segments",
      "displayName": "Customer Segments",
      "query": "SELECT segment, COUNT(*) as customer_count, ROUND(SUM(lifetime_revenue), 2) as segment_revenue FROM dev_gold.reporting.agg_customer_lifetime_value GROUP BY segment ORDER BY segment_revenue DESC"
    },
    {
      "name": "ds_top_products",
      "displayName": "Top 10 Products by Revenue",
      "query": "SELECT product_name, category, ROUND(total_revenue, 2) as total_revenue, ROUND(total_profit, 2) as total_profit, total_units_sold, ROUND(avg_profit_margin * 100, 1) as margin_pct FROM dev_gold.reporting.agg_product_performance ORDER BY total_revenue DESC LIMIT 10"
    },
    {
      "name": "ds_category_trends",
      "displayName": "Category Quarterly Trends",
      "query": "SELECT CAST(year AS STRING) as year, CONCAT('Q', CAST(quarter AS STRING)) as quarter_label, category, ROUND(total_revenue, 2) as total_revenue FROM dev_gold.reporting.agg_category_trends ORDER BY year, quarter, category"
    },
    {
      "name": "ds_product_returns",
      "displayName": "Top Return Rate Products",
      "query": "SELECT product_name, ROUND(return_rate * 100, 1) as return_rate_pct, total_returns FROM dev_gold.reporting.agg_product_performance WHERE total_returns > 0 ORDER BY return_rate DESC LIMIT 10"
    },
    {
      "name": "ds_category_margins",
      "displayName": "Sub-Category Margins",
      "query": "SELECT category, sub_category, ROUND(AVG(avg_profit_margin) * 100, 1) as avg_margin_pct FROM dev_gold.reporting.agg_category_trends GROUP BY category, sub_category ORDER BY avg_margin_pct DESC"
    },
    {
      "name": "ds_product_table",
      "displayName": "Product Performance Table",
      "query": "SELECT revenue_rank, product_name, category, sub_category, ROUND(total_revenue, 2) as total_revenue, ROUND(total_profit, 2) as total_profit, total_units_sold, ROUND(avg_profit_margin * 100, 1) as margin_pct, total_returns, ROUND(return_rate * 100, 1) as return_rate_pct FROM dev_gold.reporting.agg_product_performance ORDER BY revenue_rank LIMIT 20"
    },
    {
      "name": "ds_ltv_tiers",
      "displayName": "Customer LTV Tiers",
      "query": "SELECT ltv_tier, COUNT(*) as customer_count, ROUND(AVG(lifetime_revenue), 2) as avg_ltv FROM dev_gold.reporting.agg_customer_lifetime_value GROUP BY ltv_tier ORDER BY avg_ltv DESC"
    },
    {
      "name": "ds_top_customers",
      "displayName": "Top 15 Customers",
      "query": "SELECT customer_name, segment, ltv_tier, ROUND(lifetime_revenue, 2) as lifetime_revenue, ROUND(lifetime_profit, 2) as lifetime_profit, total_orders, ROUND(avg_order_value, 2) as avg_order_value, ROUND(return_rate * 100, 1) as return_rate_pct FROM dev_gold.reporting.agg_customer_lifetime_value ORDER BY lifetime_revenue DESC LIMIT 15"
    },
    {
      "name": "ds_shipping",
      "displayName": "Shipping Analysis",
      "query": "SELECT ship_mode, ship_mode_description, ROUND(total_revenue, 2) as total_revenue, total_orders, ROUND(avg_delivery_days, 1) as avg_delivery_days, ROUND(avg_profit_margin * 100, 1) as margin_pct, ROUND(revenue_share_pct, 1) as revenue_share_pct, ROUND(order_share_pct, 1) as order_share_pct FROM dev_gold.reporting.agg_shipping_analysis ORDER BY total_revenue DESC"
    },
    {
      "name": "ds_monthly_orders",
      "displayName": "Monthly Orders Volume",
      "query": "SELECT CAST(year AS STRING) as year, month, month_name, total_orders, total_units_sold FROM dev_gold.reporting.agg_monthly_sales ORDER BY year, month"
    },
    {
      "name": "ds_discount_profit",
      "displayName": "Discount vs Profit Margin",
      "query": "SELECT CAST(year AS STRING) as year, month, ROUND(avg_discount * 100, 1) as avg_discount_pct, ROUND(avg_profit_margin * 100, 1) as avg_margin_pct FROM dev_gold.reporting.agg_monthly_sales ORDER BY year, month"
    }
  ],
