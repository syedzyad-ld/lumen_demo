{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "KPIs",
      "queryLines": [
        "SELECT ROUND(SUM(total_revenue), 0) as total_revenue, ROUND(SUM(total_profit), 0) as total_profit, SUM(total_orders) as total_orders, ROUND(AVG(avg_profit_margin) * 100, 1) as margin_pct FROM dev_gold.reporting.agg_monthly_sales"
      ]
    },
    {
      "name": "ds_monthly",
      "displayName": "Monthly Trends",
      "queryLines": [
        "SELECT CAST(year AS STRING) as year, month, month_name, ROUND(total_revenue, 0) as revenue, ROUND(total_profit, 0) as profit, total_orders FROM dev_gold.reporting.agg_monthly_sales ORDER BY year, month"
      ]
    },
    {
      "name": "ds_region",
      "displayName": "Regional",
      "queryLines": [
        "SELECT region, manager_name, ROUND(total_revenue, 0) as revenue, ROUND(total_profit, 0) as profit, total_customers, total_orders, ROUND(avg_profit_margin*100,1) as margin_pct FROM dev_gold.reporting.agg_regional_summary ORDER BY revenue DESC"
      ]
    },
    {
      "name": "ds_segments",
      "displayName": "Segments",
      "queryLines": [
        "SELECT segment, COUNT(*) as customer_count, ROUND(SUM(lifetime_revenue), 0) as total_revenue FROM dev_gold.reporting.agg_customer_lifetime_value GROUP BY segment ORDER BY total_revenue DESC"
      ]
    },
    {
      "name": "ds_products",
      "displayName": "Top Products",
      "queryLines": [
        "SELECT product_name, category, ROUND(total_revenue, 0) as revenue, ROUND(total_profit, 0) as profit, total_units_sold as units, ROUND(return_rate*100,1) as return_pct FROM dev_gold.reporting.agg_product_performance ORDER BY revenue DESC LIMIT 15"
      ]
    },
    {
      "name": "ds_shipping",
      "displayName": "Shipping",
      "queryLines": [
        "SELECT ship_mode, total_orders, ROUND(total_revenue, 0) as revenue, ROUND(avg_delivery_days, 1) as avg_days, ROUND(avg_profit_margin*100,1) as margin_pct, ROUND(revenue_share_pct, 1) as rev_share_pct FROM dev_gold.reporting.agg_shipping_analysis ORDER BY revenue DESC"
      ]
    },
    {
      "name": "ds_customers",
      "displayName": "Top Customers",
      "queryLines": [
        "SELECT customer_name, segment, ltv_tier, ROUND(lifetime_revenue, 0) as lifetime_rev, total_orders, ROUND(avg_order_value, 0) as avg_order FROM dev_gold.reporting.agg_customer_lifetime_value ORDER BY lifetime_rev DESC LIMIT 15"
      ]
    },
    {
      "name": "ds_ltv",
      "displayName": "LTV Tiers",
      "queryLines": [
        "SELECT ltv_tier, COUNT(*) as customer_count, ROUND(AVG(lifetime_revenue), 0) as avg_revenue FROM dev_gold.reporting.agg_customer_lifetime_value GROUP BY ltv_tier ORDER BY avg_revenue DESC"
      ]
    },
    {
      "name": "ds_categories",
      "displayName": "Category Trends",
      "queryLines": [
        "SELECT CAST(year AS STRING) as year, CONCAT('Q', CAST(quarter AS STRING)) as quarter_label, category, ROUND(total_revenue, 0) as revenue, ROUND(total_profit, 0) as profit FROM dev_gold.reporting.agg_category_trends ORDER BY year, quarter"
      ]
    }
  ],
