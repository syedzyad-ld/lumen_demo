{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "KPIs",
      "queryLines": ["SELECT ROUND(SUM(total_revenue), 0) as total_revenue, ROUND(SUM(total_profit), 0) as total_profit, SUM(total_orders) as total_orders, ROUND(AVG(avg_profit_margin), 1) as avg_margin, SUM(total_units_sold) as total_units, ROUND(AVG(revenue_per_order), 0) as avg_order_value FROM dev_gold.reporting.agg_monthly_sales"]
    },
    {
      "name": "ds_monthly_trend",
      "displayName": "Monthly Trend",
      "queryLines": ["SELECT year, month, month_name, ROUND(total_revenue, 0) as total_revenue, ROUND(total_profit, 0) as total_profit, total_orders, total_units_sold, ROUND(avg_profit_margin, 1) as avg_profit_margin, ROUND(avg_discount, 2) as avg_discount, ROUND(revenue_per_order, 0) as revenue_per_order FROM dev_gold.reporting.agg_monthly_sales ORDER BY year, month"]
    },
    {
      "name": "ds_regional",
      "displayName": "Regional Summary",
      "queryLines": ["SELECT region, manager_name, ROUND(total_revenue, 0) as total_revenue, ROUND(total_profit, 0) as total_profit, total_orders, total_customers, ROUND(avg_profit_margin, 1) as avg_profit_margin, ROUND(revenue_per_customer, 0) as revenue_per_customer FROM dev_gold.reporting.agg_regional_summary ORDER BY total_revenue DESC"]
    },
    {
      "name": "ds_products",
      "displayName": "Top Products",
      "queryLines": ["SELECT product_name, category, sub_category, ROUND(total_revenue, 0) as total_revenue, ROUND(total_profit, 0) as total_profit, total_units_sold, total_orders, ROUND(avg_profit_margin, 1) as avg_profit_margin, ROUND(return_rate * 100, 1) as return_rate_pct, revenue_rank FROM dev_gold.reporting.agg_product_performance ORDER BY revenue_rank LIMIT 20"]
    },
    {
      "name": "ds_category",
      "displayName": "Category Trends",
      "queryLines": ["SELECT year, quarter, category, sub_category, ROUND(total_revenue, 0) as total_revenue, ROUND(total_profit, 0) as total_profit, total_units_sold, ROUND(avg_profit_margin, 1) as avg_profit_margin, ROUND(yoy_revenue_growth, 1) as yoy_growth_pct FROM dev_gold.reporting.agg_category_trends ORDER BY year, quarter, category"]
    },
    {
      "name": "ds_category_summary",
      "displayName": "Category Summary",
      "queryLines": ["SELECT category, ROUND(SUM(total_revenue), 0) as total_revenue, ROUND(SUM(total_profit), 0) as total_profit, SUM(total_orders) as total_orders, ROUND(AVG(avg_profit_margin), 1) as avg_margin FROM dev_gold.reporting.agg_category_trends GROUP BY category ORDER BY total_revenue DESC"]
    },
    {
      "name": "ds_customers",
      "displayName": "Top Customers",
      "queryLines": ["SELECT customer_name, segment, ROUND(lifetime_revenue, 0) as lifetime_revenue, ROUND(lifetime_profit, 0) as lifetime_profit, total_orders, ROUND(avg_order_value, 0) as avg_order_value, ltv_tier, ROUND(return_rate * 100, 1) as return_rate_pct FROM dev_gold.reporting.agg_customer_lifetime_value ORDER BY lifetime_revenue DESC LIMIT 30"]
    },
    {
      "name": "ds_ltv_tiers",
      "displayName": "LTV Tiers",
      "queryLines": ["SELECT ltv_tier, COUNT(*) as customer_count, ROUND(AVG(lifetime_revenue), 0) as avg_revenue, ROUND(AVG(total_orders), 1) as avg_orders, ROUND(AVG(avg_order_value), 0) as avg_order_value FROM dev_gold.reporting.agg_customer_lifetime_value GROUP BY ltv_tier ORDER BY avg_revenue DESC"]
    },
    {
      "name": "ds_segments",
      "displayName": "Customer Segments",
      "queryLines": ["SELECT segment, COUNT(*) as customer_count, ROUND(SUM(lifetime_revenue), 0) as total_revenue, ROUND(AVG(lifetime_revenue), 0) as avg_revenue, ROUND(AVG(total_orders), 1) as avg_orders FROM dev_gold.reporting.agg_customer_lifetime_value GROUP BY segment ORDER BY total_revenue DESC"]
    },
    {
      "name": "ds_shipping",
      "displayName": "Shipping Analysis",
      "queryLines": ["SELECT ship_mode, ship_mode_description, ROUND(total_revenue, 0) as total_revenue, ROUND(total_profit, 0) as total_profit, total_orders, ROUND(avg_delivery_days, 1) as avg_delivery_days, ROUND(avg_profit_margin, 1) as avg_profit_margin, ROUND(revenue_share_pct, 1) as revenue_share_pct, ROUND(order_share_pct, 1) as order_share_pct FROM dev_gold.reporting.agg_shipping_analysis ORDER BY total_revenue DESC"]
    },
    {
      "name": "ds_yearly",
      "displayName": "Yearly Summary",
      "queryLines": ["SELECT year, ROUND(SUM(total_revenue), 0) as annual_revenue, ROUND(SUM(total_profit), 0) as annual_profit, SUM(total_orders) as annual_orders, ROUND(AVG(avg_profit_margin), 1) as avg_margin FROM dev_gold.reporting.agg_monthly_sales GROUP BY year ORDER BY year"]
    }
  ],
